# Sao chép file này thành `.env` rồi điền giá trị thật.
# Vite chỉ nạp các biến có tiền tố VITE_ vào code phía client.

# URL gốc của Backend API (không có dấu "/" ở cuối).
# Dev cục bộ:  http://localhost:3000/api
# Deploy:      https://horse-race-aoot.onrender.com/api
VITE_API_URL=http://localhost:3000/api
